# Postgres connection string (Neon via Vercel Marketplace, or any Postgres)
DATABASE_URL=

# Clerk (https://dashboard.clerk.com → API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# While no users exist, this email becomes admin on first sign-in
SIGTIL_ADMIN_EMAIL=

# OpenRouter API key (one key, any model) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model served through OpenRouter
SIGTIL_MODEL=anthropic/claude-sonnet-5

# Vercel API token — used to read deployment status of connected sites
# https://vercel.com/account/tokens
VERCEL_TOKEN=

# Vercel Blob store token — used for video uploads (images go into the repo)
BLOB_READ_WRITE_TOKEN=
