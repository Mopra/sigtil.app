# Postgres connection string (Neon via Vercel Marketplace, or any Postgres)
DATABASE_URL=

# Secret for signing session cookies — any long random string
AUTH_SECRET=

# Vercel AI Gateway key (one key, any model) — https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=

# Model served through the gateway
SIGTIL_MODEL=anthropic/claude-sonnet-4.5

# Vercel API token — used to read deployment status of connected sites
# https://vercel.com/account/tokens
VERCEL_TOKEN=

# Vercel Blob store token — used for video uploads (images go into the repo)
BLOB_READ_WRITE_TOKEN=

# One-time bootstrap code for creating the first admin user via /login
SIGTIL_BOOTSTRAP_CODE=
